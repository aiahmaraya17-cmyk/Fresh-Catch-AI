# FreshCatch AI — Backend environment
# ====================================
# Copy to .env for local development. In production (Render), set these in the
# service's Environment settings instead of committing a .env file.

# Port the API listens on. Render provides this automatically.
PORT=5000

# Secret used to sign JWT auth tokens. MUST be a long random string in prod.
# Generate one, e.g.:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-secret

# Environment mode.
NODE_ENV=development

# ── Python inference engine ──────────────────────────────────────────────────
# Path to the Python interpreter the Node bridge spawns for CNN inference.
#   - Local (Windows/macOS/Linux): "python" (or "python3")
#   - Docker/Render image:         "/opt/venv/bin/python"
PYTHON_PATH=python

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed front-end origins (no trailing slash).
# Leave EMPTY in local dev (all origins allowed). In production set to your
# Vercel URL(s), e.g.:
#   CORS_ORIGINS=https://freshcatch-ai.vercel.app
CORS_ORIGINS=

# ── Persistent storage (production) ──────────────────────────────────────────
# Leave these UNSET locally (defaults keep files inside the project).
# In production, point them at a mounted persistent disk so data survives
# restarts and redeploys. On Render with a disk mounted at /data:
#   DATABASE_PATH=/data/freshcatch.db
#   UPLOAD_DIR=/data/uploads
# DATASET_DIR is optional (training/demo images).
DATABASE_PATH=
UPLOAD_DIR=
DATASET_DIR=
