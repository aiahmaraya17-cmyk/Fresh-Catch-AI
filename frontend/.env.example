# FreshCatch AI — Frontend environment
# ------------------------------------
# Base URL of the backend API (the Render service).
#   - LOCAL DEV: leave this EMPTY. The Vite dev proxy forwards /api, /uploads,
#     and /dataset to http://localhost:5000 automatically.
#   - PRODUCTION (Vercel): set it to your Render backend origin, with NO trailing
#     slash and NO /api suffix, e.g.
#     VITE_API_BASE_URL=https://freshcatch-api.onrender.com
VITE_API_BASE_URL=
